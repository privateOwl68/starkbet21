# App env — copy to app/.env.local
# Vite loads .env / .env.local only (a file named ".env " with a trailing space is ignored).

# localnet | sepolia | mainnet
VITE_NETWORK=sepolia

# Optional RPC for Vite /rpc proxy
# VITE_RPC_PROXY=https://starknet-sepolia.public.blastapi.io/rpc/v0_8

# Table relayer (= deploy owner). After "Enable gasless play" once, deal/hit/stand
# are signed by this key — no player wallet popups. Demo only; use a backend in prod.
# VITE_RELAYER_ADDRESS=0x…
# VITE_RELAYER_PRIVATE_KEY=0x…
