# Repo root env for deploy scripts (copy to .env — never commit .env)
#
#   cp .env.example .env
#   sncast account list   # pick ACCOUNT_NAME + its address

# Sepolia RPC (required for ./scripts/deploy_sepolia.sh)
RPC_URL=https://starknet-sepolia.public.blastapi.io/rpc/v0_8

# Deployer / game owner — must be a real Sepolia sncast account (deployed + funded)
# Create: sncast account create --name=sepolia --network=sepolia
# Fund with Sepolia STRK, then: sncast account deploy --name=sepolia --network=sepolia
OWNER_ADDRESS=0xYOUR_DEPLOYED_SEPOLIA_ACCOUNT

# sncast account name from `sncast account list` (deployed: true on alpha-sepolia)
ACCOUNT_NAME=sepolia

# Optional STRK20 anonymizer deploy
# STRK_TOKEN=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d
# PRIVACY_POOL=0x0254a6b2997ef52e9f830ce1f543f6b29768295e8d17e2267d672c552cfe0d91
